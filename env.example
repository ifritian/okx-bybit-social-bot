# --- Telegram (Bot API - бот добавлен админом в канал) ---
FOLLOWUP_CHANNEL_USERNAME=resultrsi
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Канал для кросспостинга собственных постов (см. комментарий в config.py) -
# "@my_channel" для публичного канала, либо числовой chat_id для приватного.
TELEGRAM_PUBLISH_CHANNEL=@your_channel

# Твой Telegram USER_ID (опционально)
YOUR_USER_ID=

# --- Binance Square ---
BINANCE_SQUARE_API_KEY=your_binance_square_api_key_here

# --- Bluesky (AT Protocol) - кросспостинг, опционально ---
# BLUESKY_HANDLE - твой handle, например alexei.bsky.social.
# BLUESKY_APP_PASSWORD - App Password (Settings -> App passwords в
# самом Bluesky), НЕ основной пароль от аккаунта.
# Если оба поля пустые - кросспостинг в Bluesky тихо пропускается, как
# и с Telegram выше.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# Доля обычных сигналов с картинкой, уходящих в Bluesky тизером
# (график почти без слов) вместо полного текста - 0.25 = каждый 4-й
BLUESKY_TEASER_PROBABILITY=0.25

# --- Groq (генерация текста и зрение, бесплатно) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Расписание трёх форматов постов ---
MIN_POST_INTERVAL_HOURS=4
OPINION_INTERVAL_HOURS=48
# Формат "Хот-тейк" - публикуется ТОЛЬКО в Bluesky, отдельное расписание
HOT_TAKE_INTERVAL_HOURS=60
HOT_TAKE_JITTER_HOURS=6
# Формат "Мини-урок" - тоже только Bluesky, своё расписание
MINI_LESSON_INTERVAL_HOURS=84
MINI_LESSON_JITTER_HOURS=8
# Формат "Вопрос аудитории" - тоже только Bluesky, раз в неделю
AUDIENCE_QUESTION_INTERVAL_HOURS=168
AUDIENCE_QUESTION_JITTER_HOURS=12

# Формат "Экстренный" - проверяется каждый тик, не по расписанию
VOLATILITY_ALERT_THRESHOLD_PCT=4.0
VOLATILITY_ALERT_WINDOW_HOURS=3
EMERGENCY_COOLDOWN_HOURS=6

# Формат "Глоссарий" - только Telegram, последовательная серия
TELEGRAM_GLOSSARY_INTERVAL_HOURS=96
TELEGRAM_GLOSSARY_JITTER_HOURS=8

# Форматы "Опрос" и "AMA" - тоже только Telegram
TELEGRAM_POLL_INTERVAL_HOURS=120
TELEGRAM_POLL_JITTER_HOURS=10
TELEGRAM_AMA_INTERVAL_HOURS=240
TELEGRAM_AMA_JITTER_HOURS=12

# Формат "Предложения по ребалансировке" - только Telegram, раз в месяц.
# Бот только предлагает кандидатов, состав корзины (treasury_index.py,
# BASKET) меняет вручную человек.
REBALANCE_REVIEW_INTERVAL_HOURS=720
REBALANCE_REVIEW_JITTER_HOURS=24

# Диаграмма состава корзины - раз в N постов Treasury Index (14 при цикле
# в 12ч ~= раз в неделю), тепловая карта - каждый пост, без настройки
TREASURY_COMPOSITION_INTERVAL_POSTS=14
ARTICLE_INTERVAL_HOURS=168

POLL_INTERVAL_SECONDS=60

# --- Трекинг результатов сигналов (outcome_tracker.py) ---
# Через сколько часов после публикации сигнал закрывается как "timeout",
# если цена не дошла ни до тейка, ни до стопа.
OUTCOME_MAX_TRACK_HOURS=48

# Если currency-формат не публиковался дольше этого числа часов - алерт
# в личку Telegram (нужен YOUR_USER_ID выше).
DEAD_MANS_SWITCH_HOURS=24

# --- Еженедельный отчёт точности сигналов (accuracy_report_generator.py) ---
ACCURACY_REPORT_INTERVAL_HOURS=168
ACCURACY_REPORT_JITTER_HOURS=6
ACCURACY_REPORT_MIN_CLOSED_SIGNALS=5

# Разбор неудачных сигналов (Фаза 4, вторая часть) - реже, чем
# accuracy_report (по умолчанию раз в 2 недели / 336ч).
LOSS_REVIEW_INTERVAL_HOURS=96
LOSS_REVIEW_JITTER_HOURS=6
LOSS_REVIEW_LOOKBACK_DAYS=4.5
LOSS_REVIEW_MIN_LOSSES=1

# Сигналы "удобно купить/продать" по монетам Treasury Index (умный
# менеджмент по индексу) - RSI/Bollinger сканер, но только на 15
# монетах корзины, не по всему рынку.
INDEX_SIGNAL_INTERVAL_HOURS=8
INDEX_SIGNAL_JITTER_HOURS=2
MIN_INDEX_SIGNAL_SCORE_TO_PUBLISH=55
INDEX_SIGNAL_ALERT_COOLDOWN_HOURS=12
INDEX_SIGNAL_MAX_AGE_HOURS=2

# --- Futures-исполнение (testnet по умолчанию - см. futures_client.py) ---
# BINANCE_FUTURES_API_KEY/BINANCE_FUTURES_API_SECRET обычно задаются через
# export перед запуском futures_testnet_demo.py/risk_guard_cli.py, а не
# здесь - см. их docstring. Ниже - только числовые настройки риска.
BINANCE_FUTURES_USE_TESTNET=true
BINANCE_FUTURES_DEFAULT_LEVERAGE=3
BINANCE_FUTURES_RISK_PCT_PER_TRADE=1.0
# Предохранители ПОВЕРХ отдельной сделки (см. risk_guard.py) - максимум
# одновременно открытых позиций, дневной лимит убытка в % от баланса,
# серия убыточных сделок подряд. При превышении двух последних risk_guard
# взводит kill switch (по умолчанию снимается только вручную -
# risk_guard_cli.py reset; см. BINANCE_FUTURES_KILL_SWITCH_AUTO_RESET_HOURS
# ниже, если нужен автосброс по таймауту).
BINANCE_FUTURES_MAX_OPEN_POSITIONS=3
BINANCE_FUTURES_MAX_DAILY_LOSS_PCT=5.0
BINANCE_FUTURES_MAX_CONSECUTIVE_LOSSES=3
# Через сколько часов после срабатывания kill switch бот САМ его снимает,
# без ручного risk_guard_cli.py reset. 0 = выключено (дефолт, нужно
# ручное снятие). Пример: 24 - если торговля встала утром, к следующему
# утру бот попробует снова сам, без вашего участия.
BINANCE_FUTURES_KILL_SWITCH_AUTO_RESET_HOURS=0
# Порог score для АВТОМАТИЧЕСКОГО исполнения сигнала (futures_auto_trade.py) -
# отдельный и по умолчанию строже, чем MIN_SIGNAL_SCORE_TO_PUBLISH выше
# (тот - "достаточно хорош для поста", этот - "достаточно хорош, чтобы
# рискнуть деньгами без подтверждения человека"). 90 = только
# "Conservative" сигналы - по факту накопленной статистики диапазон
# 70-89 ("Moderate") в среднем убыточен, см. комментарий в config.py.
BINANCE_FUTURES_MIN_SIGNAL_SCORE=90
