# --- Telegram ---
# Можно использовать ТОТ ЖЕ бот-токен, что и в binance-square-bot -
# черновики уходят в другой chat_id, так что проекты не пересекаются.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- Groq (LLM, бесплатный тир) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_SECONDARY=openai/gpt-oss-20b

# --- OKX Orbit ---
OKX_ORBIT_ENABLED=true
# Личный chat_id (НЕ канал) - получить через @userinfobot в Telegram.
# Должен ОТЛИЧАТЬСЯ от того, что используется в binance-square-bot,
# иначе черновики двух проектов будут сыпаться в один чат вперемешку.
OKX_ORBIT_DRAFT_CHAT_ID=
OKX_ORBIT_INTERVAL_HOURS=8
OKX_ORBIT_JITTER_HOURS=2

# --- Bybit ByX ---
BYBIT_BYX_ENABLED=true
# Отдельный chat_id от OKX_ORBIT_DRAFT_CHAT_ID - иначе черновики двух
# бирж будут падать в один чат вперемешку.
BYBIT_BYX_DRAFT_CHAT_ID=
BYBIT_BYX_INTERVAL_HOURS=8
BYBIT_BYX_JITTER_HOURS=2

# --- Новостной формат ("мнение по новости", см. news_opinion_generator.py) ---
# Публичный Telegram-канал, чей t.me/s/<канал> превью-страница читается
# без какого-либо аккаунта. @forklog - независимое крипто-медиа.
NEWS_SOURCE_CHANNEL=forklog
# Включить формат отдельно для каждой биржи - пару раз в неделю
# (гейтинг по времени зашит в news_opinion_generator.py, не тут).
OKX_NEWS_ENABLED=true
BYBIT_NEWS_ENABLED=true
